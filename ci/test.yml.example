# github actions example; move to .github/workflows/test.yml to activate.
name: test

on:
  push:
    branches: [main]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: install cpu-only deps for tests
        run: |
          python -m pip install --upgrade pip
          # skip torch cuda wheels; install cpu-only for CI
          pip install torch==2.6.0 torchvision==0.21.0 --index-url https://download.pytorch.org/whl/cpu
          # skip xformers on CI (cuda-only)
          grep -v '^xformers' requirements.txt > /tmp/req.txt
          pip install -r /tmp/req.txt
      - name: compile
        run: python -m compileall -q src tests
      - name: pytest
        env:
          CUDA_VISIBLE_DEVICES: ""
        run: pytest -q -k "not gpu"
